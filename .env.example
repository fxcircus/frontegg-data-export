# Frontegg vendor API credentials
#
# Where to get these:
#   Frontegg Portal → Settings → API Keys → "Vendor Key" (clientId + secret)
#
# Quick start: copy this file to .env, then fill in the values below.
#   cp .env.example .env

FRONTEGG_CLIENT_ID=
FRONTEGG_CLIENT_SECRET=

# Frontegg API base URL — pick the region your environment is hosted in:
#   https://api.frontegg.com         (EU — default region)
#   https://api.us.frontegg.com      (US)
#   https://api.ca.frontegg.com      (Canada)
#   https://api.au.frontegg.com      (Australia)
#
# If unsure, find the right host in your Frontegg Portal under your environment's
# API documentation page.

FRONTEGG_BASE_URL=https://api.frontegg.com
